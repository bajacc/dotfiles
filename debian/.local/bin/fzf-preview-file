#!/bin/sh

file="$1"

if [ -d "$file" ]; then
	ls -A "$file"
elif command -v bat >/dev/null 2>&1; then
	bat --style=numbers --color=always --line-range :500 "$file"
elif command -v batcat >/dev/null 2>&1; then
	batcat --style=numbers --color=always --line-range :500 "$file"
else
	head -n 500 "$file"
fi
